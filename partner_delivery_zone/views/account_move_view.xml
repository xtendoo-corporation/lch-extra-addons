<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="account_move_form_delivery_zone" model="ir.ui.view">
        <field name="name">account.move.form.delivery.zone</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_user_id']" position="after">
                <field name="delivery_zone_id"
                       readonly="state != 'draft'" invisible="move_type not in ['out_invoice', 'out_refund', 'in_invoice', 'in_refund']"/>
            </xpath>
        </field>
    </record>

    <record id="account_move_list_delivery_zone" model="ir.ui.view">
        <field name="name">account.move.list.delivery.zone</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="(//field[@name='invoice_partner_display_name'])[last()]" position="after">
                <field name="delivery_zone_id" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
