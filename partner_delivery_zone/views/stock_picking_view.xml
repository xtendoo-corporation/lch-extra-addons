<odoo>

    <record id="view_picking_form" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="delivery_zone_id"
                    readonly="state == 'done'"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_internal_search" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <!-- 15.0: group_id ya no esta en la vista de busqueda -->
            <field name="picking_type_id" position="after">
                <separator/>
                <field name="delivery_zone_id"/>
            </field>
            <xpath expr="//filter[@name='picking_type']/.." position="inside">
                <filter name="delivery_zone_group" string="Delivery Zone" context="{'group_by': 'delivery_zone_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="picking_view_delivery_kanban" model="ir.ui.view">
        <field name="name">stock.picking.delivery.kanban</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.stock_picking_kanban"/>
        <field name="arch" type="xml">
            <!-- 15.0: el campo es scheduled_date; la zona se anade DENTRO de oe_kanban_bottom_left (no se reemplaza el bloque: 15 incluye ahi el widget de actividades) -->
            <xpath expr="//field[@name='scheduled_date']" position="after">
                <field name="delivery_zone_id" />
            </xpath>
            <!-- 18.0: oe_kanban_bottom_left desaparece (tarjeta t-name="card"); la zona se muestra junto al cliente del pie -->
            <xpath expr="//footer//field[@name='partner_id']" position="after">
                <field name="delivery_zone_id" class="ms-2 text-muted"/>
            </xpath>
        </field>
    </record>

    <record id="picking_view_delivery_tree" model="ir.ui.view">
        <field name="name">stock.picking.delivery.list</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="delivery_zone_id" />
            </xpath>
        </field>
    </record>
</odoo>
