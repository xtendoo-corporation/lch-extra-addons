<?xml version="1.0"?>
<odoo>

    <record id="wizard_report_sale_delivery_zone" model="ir.ui.view">
        <field name="name">wizard_report_sale_delivery_zone</field>
        <field name="model">wizard.report.sale.delivery.zone</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="date_report"/>
                </group>
                <footer>
                    <button string="Select"
                            name="action_print_report"
                            type="object"
                            default_focus="1"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-default"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="menu_action_report_sale_delivery_zone" model="ir.actions.act_window">
        <field name="name">Report Sale Delivery Zone</field>
        <field name="res_model">wizard.report.sale.delivery.zone</field>
        <field name="view_mode">form</field>
        <field name="view_id">wizard_report_sale_delivery_zone</field>
        <field name="target">new</field>
    </record>

    <record id="action_report_sale_delivery_zone_visit_day" model="ir.actions.act_window">
        <field name="name">Report Sales Delivery Zones</field>
        <field name="res_model">wizard.report.sale.delivery.zone</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="partner_delivery_zone_wizard_action" model="ir.actions.act_window">
        <field name="name">Report Date</field>
        <field name="binding_model">partner.delivery.zone</field>
        <field name="res_model">wizard.report.sale.delivery.zone</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups">base.group_partner_manager</field>
    </record>

</odoo>
