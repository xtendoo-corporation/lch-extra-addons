<odoo>
    <!-- En 19 la lista de pagos de cliente y de proveedor es la misma vista (en v12 eran dos). -->
    <record id="view_account_payment_tree_show_invoice" model="ir.ui.view">
        <field name="name">account.payment.list - show invoice</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="invoice_vendor_references"/>
            </field>
        </field>
    </record>
</odoo>
